# Railway MLflow tracking/UI service for Mirai DoE.
# MLflow 3.x skinny plus explicit server deps; matches the MLflow 3.x backend schema.

FROM python:3.11-slim

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
ENV PYTHONUNBUFFERED=1
ENV MLFLOW_WORKERS=1
ENV MLFLOW_SERVER_ENABLE_JOB_EXECUTION=false
ENV MLFLOW_DISABLE_TELEMETRY=true
WORKDIR /app

RUN uv pip install --system \
    "mlflow[auth]==3.13.0" \
    "aiohttp>=3.9.0" \
    "psycopg2-binary>=2.9.9" \
    "boto3>=1.34.0"

COPY scripts/start_mlflow_auth_server.sh /app/start_mlflow_auth_server.sh
COPY scripts/mlflow_basic_auth_proxy.py /app/mlflow_basic_auth_proxy.py
RUN chmod 755 /app/start_mlflow_auth_server.sh

EXPOSE 5000

CMD ["/app/start_mlflow_auth_server.sh"]
