# Keep Railway source upload small and deterministic.
# The image only needs source code plus small packaged demo/reference artifacts.

# Ignore everything by default, then re-include the Docker build inputs below.
*

# Root deployment files
!Dockerfile.railway
!Dockerfile.mlflow
!railway.toml
!railway.mlflow.toml
!.dockerignore

# MLflow service entrypoint
!scripts/
scripts/*
!scripts/start_mlflow_auth_server.sh
!scripts/mlflow_basic_auth_proxy.py

# Backend source and package metadata
!backend/
backend/*
!backend/app/
!backend/app/**
!backend/ml_lifecycle/
!backend/ml_lifecycle/**
!backend/pyproject.toml
!backend/uv.lock
!backend/healthcheck.py

# Tiny seed metadata required by the bootstrap/demo image
!backend/seeds/
!backend/seeds/**

# Legacy local object-store and MLflow state must never be uploaded to Railway.
backend/data-minio/
backend/data-minio/**
backend/.object-storage-local/
backend/.object-storage-local/**
backend/mlruns/
backend/mlruns/**

# Frontend source and build metadata, but not local dependencies/build output
!frontend/
frontend/*
!frontend/src/
!frontend/src/**
!frontend/public/
!frontend/public/**
!frontend/package.json
!frontend/package-lock.json
!frontend/tsconfig.json
!frontend/tsconfig.node.json
!frontend/vite.config.ts
!frontend/postcss.config.cjs
!frontend/tailwind.config.cjs
!frontend/index.html
!frontend/.eslintrc.cjs

# Production/demo data and model artifacts live in Railway S3/Postgres/MLflow.
# Do not upload local data mirrors or generated artifacts with GitHub builds.

# Always exclude local/generated heavy or secret material
.env
.env.*
.envrc
**/.env
**/.env.*
**/node_modules
**/.venv
**/__pycache__
**/.pytest_cache
frontend/dist
backend/data-minio/intake
backend/data-minio/intake/**
backend/.mlflow-cache
.DS_Store
