# Mirai DoE local training from an exported approved package -> remote MLflow
# Copy to backend/.env.training.local and fill in values locally.
# Do not commit backend/.env.training.local.

# Required: remote MLflow tracking server. Use the Railway MLflow HTTPS URL.
MLFLOW_TRACKING_URI=

# Required safety guards. The local exported-package trainer refuses to run unless
# both are enabled, and the generic trainer will not silently fall back to backend/mlruns.
MIRAI_TRAINING_REQUIRE_REMOTE_MLFLOW=true
MIRAI_TRAINING_REQUIRE_REMOTE_ARTIFACTS=true

# Optional only if the remote MLflow experiment does not already have a remote
# artifact location and your MLflow setup needs an explicit artifact root at
# experiment creation time. Prefer preconfigured remote MLflow artifact storage.
# MLFLOW_ARTIFACT_ROOT=s3://<remote-mlflow-artifact-bucket-or-prefix>

# Intentionally not included here:
# - Railway DATABASE_URL / Postgres credentials
# - Clerk secrets
# - Mirai API tokens
# - direct Railway application S3 access keys
# - OBJECT_STORAGE_BACKEND or .object-storage-local settings
