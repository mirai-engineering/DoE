{
  "manifest_version": "0.3",
  "project": {
    "project_id": "fraunhofer2miraicontract_full",
    "display_name": "Fraunhofer Full Cathode Catalyst Degradation Mirai Contract Package",
    "domain": "fuel_cell",
    "template_id": "generic_tabular_doe",
    "description": "Full 42-cell package recomputed from raw Fraunhofer cathode catalyst degradation files and mapped to the Mirai fixed source-table contract.",
    "source_pdf": "data/PEM Fuel Cell Catalyst Optimization.pdf",
    "parity_notes": {
      "paper_inputs": "7 features: Pt/C ratio, I/C ratio, ionomer EW, operating RH, voltage, AST RH, AST UPL",
      "paper_outputs": "4 targets: BoL current density, EoL current density, BoL ECSA, ECSA loss",
      "reported_model": "ANN, hidden layers 7/14/8, ReLU, Adam, MSE, min-max scaling, 80/20 split, 8-fold CV, L2 alpha 0.0015",
      "reported_unseen_metrics": "R-squared 0.9856 BoL and 0.9774 EoL; MSE 0.25"
    }
  },
  "tables": [
    {
      "path": "experiments.csv",
      "table_type": "experiments",
      "primary_key": [
        "experiment_id"
      ],
      "description": "One row per cell/material/AST experiment across all 42 cells."
    },
    {
      "path": "conditions.csv",
      "table_type": "conditions",
      "primary_key": [
        "condition_id",
        "experiment_id"
      ],
      "description": "One row per operating RH/voltage point across all cell experiments."
    },
    {
      "path": "results.csv",
      "table_type": "results",
      "primary_key": [
        "result_id"
      ],
      "description": "One row per output vector for each condition."
    }
  ],
