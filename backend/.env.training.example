# Mirai local-training -> Railway MLflow/S3 configuration
# Copy to backend/.env.training or export these variables in your shell.
# Do not put real secrets in this example file.

# -----------------------------------------------------------------------------
# Data source for local training
# -----------------------------------------------------------------------------
# local: read from a gitignored local mirror under LOCAL_OBJECT_STORAGE_ROOT/<bucket>/<logical-key>
# s3:    read directly from Railway/S3-compatible object storage using S3 credentials
OBJECT_STORAGE_BACKEND=local
LOCAL_OBJECT_STORAGE_ROOT=backend/.object-storage-local
OBJECT_STORAGE_BUCKET=mirai-fuel-cells-demo
# OBJECT_STORAGE_BUCKET=mirai-batteries-demo

# Logical key example. The path after the bucket is identical locally and in S3:
#   backend/.object-storage-local/mirai-fuel-cells-demo/workspaces/fraunhofer/projects/fuel-cell/intake/model_table.csv
#   s3://mirai-fuel-cells-demo/workspaces/fraunhofer/projects/fuel-cell/intake/model_table.csv
TRAINING_DATA_OBJECT_KEY=workspaces/fraunhofer/projects/fuel-cell/intake/model_table.csv

# Optional S3-compatible Railway object storage settings for OBJECT_STORAGE_BACKEND=s3
S3_ENDPOINT_URL=https://<railway-s3-endpoint>
S3_REGION=auto
S3_ACCESS_KEY_ID=<railway-bucket-access-key>
S3_SECRET_ACCESS_KEY=<railway-bucket-secret-key>

# boto3/MLflow S3 artifact clients typically read AWS_* names.
AWS_ENDPOINT_URL=${S3_ENDPOINT_URL}
AWS_ACCESS_KEY_ID=${S3_ACCESS_KEY_ID}
AWS_SECRET_ACCESS_KEY=${S3_SECRET_ACCESS_KEY}
AWS_DEFAULT_REGION=${S3_REGION}
MLFLOW_S3_ENDPOINT_URL=${S3_ENDPOINT_URL}

# -----------------------------------------------------------------------------
# Railway MLflow tracking and artifact storage
# -----------------------------------------------------------------------------
# Point local training runs to Railway MLflow. Use the public/private Railway URL
# appropriate for where the command is running.
MLFLOW_TRACKING_URI=https://<railway-mlflow-domain>
MLFLOW_EXPERIMENT_NAME=fuel-cell
MIRAI_MLFLOW_WORKSPACE_ID=fraunhofer

# Experiment artifact location is derived as:
#   s3://$MIRAI_FRAUNHOFER_S3_BUCKET/workspaces/fraunhofer/projects/<project_id>/mlflow-artifacts
MIRAI_FRAUNHOFER_S3_BUCKET=mirai-fuel-cells-demo
MIRAI_BATTERIES_S3_BUCKET=mirai-batteries-demo

# Demo mode should fail if artifacts cannot be logged to Railway MLflow/S3.
MIRAI_TRAINING_REQUIRE_REMOTE_MLFLOW=1
MIRAI_TRAINING_REQUIRE_REMOTE_ARTIFACTS=1

# -----------------------------------------------------------------------------
# Local-only development escape hatch
# -----------------------------------------------------------------------------
# For quick offline experiments only. Do not use for Railway demo evidence.
# MLFLOW_TRACKING_URI=file:///${PWD}/backend/mlruns
# MIRAI_TRAINING_REQUIRE_REMOTE_MLFLOW=0
# MIRAI_TRAINING_REQUIRE_REMOTE_ARTIFACTS=0
