# Backend Configuration
CORS_ORIGINS=http://localhost:3000,http://frontend:3000

# Canonical Railway/production contract
# CLERK_AUTH_REQUIRED=true
# CLERK_JWT_ISSUER=https://<your-clerk-issuer>
# DATABASE_URL=postgresql://...
# MIRAI_REQUIRE_POSTGRES_CONTROL_PLANE=true
# OBJECT_STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=https://...
# S3_ACCESS_KEY_ID=<set in Railway only>
# S3_SECRET_ACCESS_KEY=<set in Railway only>
# S3_REGION=auto
# VITE_CLERK_PUBLISHABLE_KEY=pk_...

# Local development object storage
OBJECT_STORAGE_BACKEND=local
LOCAL_OBJECT_STORAGE_ROOT=backend/.object-storage-local

# Optional local/frontend configuration
VITE_API_URL=http://localhost:8000

# Deprecated: do not remove existing Railway variables until post-test cleanup.
# CLERK_ISSUER
# CLERK_WORKSPACE_ID_MODE
# CLERK_DEFAULT_WORKSPACE_ID
# MIRAI_STORAGE_BACKEND
# MIRAI_WORKSPACE_BUCKET_MAP
# MIRAI_FRAUNHOFER_S3_*
# MIRAI_BATTERY_DEMO_S3_*
# MIRAI_S3_REGION
# DOE_OBJECT_STORE_ROOT

# Never put CLERK_SECRET_KEY, backend secrets, or S3 secrets in frontend .env files.
