# Backend Configuration
CORS_ORIGINS=http://localhost:3000,http://frontend:3000

# Object storage
# Local development uses an ignored mirror/cache. Railway/prod should set
# OBJECT_STORAGE_BACKEND=s3 and provide bucket credentials via Railway variables.
OBJECT_STORAGE_BACKEND=local
LOCAL_OBJECT_STORAGE_ROOT=backend/.object-storage-local
# Deprecated local-only alias kept for old scripts during migration:
# DOE_OBJECT_STORE_ROOT=backend/.object-storage-local

# Frontend Configuration
VITE_API_URL=http://localhost:8000

