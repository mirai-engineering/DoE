{
  "manifest_version": "0.2",
  "project": {
    "project_id": "example_generic_surrogate",
    "display_name": "Example Generic Surrogate",
    "domain": "generic_tabular_doe",
    "template_id": "generic_tabular_doe",
    "owner": "company-or-team-name"
  },
  "tables": [
    {
      "path": "model_table.csv",
      "table_type": "model_table",
      "primary_key": ["experiment_id"],
      "description": "One row per modelable experiment, sample condition, or test point."
    }
  ],
  "columns": [
    {
      "table": "model_table.csv",
      "name": "experiment_id",
      "role": "id",
      "dtype": "string",
      "unit": null,
      "required": true,
      "ui_label": "Experiment ID",
      "description": "Unique experiment/sample/test identifier."
    },
    {
      "table": "model_table.csv",
      "name": "temperature_c",
      "role": "input",
      "dtype": "float",
      "unit": "degC",
      "required": true,
      "allowed_min": 0,
      "allowed_max": 120,
      "ui_label": "Temperature",
      "description": "Controlled test temperature."
    },
    {
      "table": "model_table.csv",
      "name": "batch_id",
      "role": "group",
      "dtype": "string",
      "unit": null,
      "required": false,
      "ui_label": "Batch",
      "description": "Grouping variable for split/diagnostics."
    },
    {
      "table": "model_table.csv",
      "name": "performance_metric",
      "role": "output",
      "dtype": "float",
      "unit": "domain-specific",
      "required": true,
      "allowed_min": null,
      "allowed_max": null,
      "direction": "maximize",
      "ui_label": "Performance metric",
      "description": "Target KPI to model."
    }
  ],
  "joins": [],
  "split_hints": {
    "group_key": "batch_id",
    "time_column": null,
    "predefined_split_column": null,
    "recommended_strategy": "grouped",
    "holdout_fraction": 0.15,
    "validation_fraction": 0.15
  },
  "ui_config": {
    "test_article_label": "Sample",
    "default_group_by": "batch_id",
    "default_output": "performance_metric"
  },
  "plot_recipes": [
    {
      "id": "performance_by_temperature",
      "label": "Performance by temperature",
      "kind": "scatter_response",
      "x": {"source": "input", "variable": "temperature_c"},
      "y": {"source": "prediction", "variable": "performance_metric"},
      "group_by": "batch_id",
      "safe": true,
      "recommended": true
    }
  ],
  "notes": "Mirai contract is required. Rename variables freely, but every model input/output must have approved role, dtype, unit, bounds where applicable, and output direction."
}
